{
  "name": "moja-przegladarka",
  "version": "0.1.0",
  "private": true,
  "description": "Własna przeglądarka — UI, pasek, sidebar, ustawienia.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node test/home-widgets.test.mjs && node test/notes.test.mjs && node --experimental-strip-types test/url-display.test.mjs && node --experimental-strip-types test/bangs.test.mjs && node --experimental-strip-types test/omnibox-ghost.test.mjs && npx tsx test/store.test.mjs && npx tsx test/store-persist-hydrate.test.mjs && npx tsx test/shortcuts-registry.test.mjs && node test/popup-policy.test.cjs && node test/partitions.test.cjs && node test/ua-chrome.test.cjs && npx tsx test/tab-navigate.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER=http://127.0.0.1:5173 electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@ghostery/adblocker": "^2.18.2",
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-chrome-extensions": "^4.9.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.475.0",
    "motion": "^13.4.6",
    "openpgp": "^6.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "local.djxxr.przegladarka",
    "productName": "Vio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/vio-256.png",
      "build/vio-512.png",
      "scripts/perf-bench.cjs",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "REPLACE_WITH_YOUR_GITHUB_USER",
        "repo": "djxxr-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "icon": "build/vio-512.png",
      "category": "Network;WebBrowser",
      "executableName": "vio",
      "target": [
        "rpm",
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Vio",
      "uninstallDisplayName": "Vio"
    }
  }
}
