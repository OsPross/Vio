{
  "name": "moja-przegladarka",
  "version": "0.1.0",
  "private": true,
  "description": "Własna przeglądarka — UI, pasek, sidebar, ustawienia.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node test/home-widgets.test.mjs && node test/notes.test.mjs && node --experimental-strip-types test/url-display.test.mjs && node --experimental-strip-types test/bangs.test.mjs && node --experimental-strip-types test/omnibox-ghost.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER=http://127.0.0.1:5173 electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@ghostery/adblocker": "^2.18.2",
    "@ghostery/adblocker-electron": "^2.18.2",
    "lucide-react": "^0.475.0",
    "motion": "^13.4.6",
    "openpgp": "^6.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "local.djxxr.przegladarka",
    "productName": "Moja Przeglądarka",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    }
  }
}
